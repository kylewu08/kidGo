# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 範本檔沒有秘密，要進版控——否則接手的人不知道需要設哪些變數
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# KidGo 本地資料庫（ADR-0001：資料庫是一個本地檔案，不進版控）
# 備份檔含小孩生日等個人資料，同樣不進版控
/data/backup/
/data/*.db
/data/*.db-shm
/data/*.db-wal

# 已作廢的 registry 憑證檔（ADR-0023 移除了這個流程）。
# 保留這條規則當安全網——它含 token，絕不能進版控。
docker-config.json
